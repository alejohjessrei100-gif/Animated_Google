{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "play",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "build": { "command": "node tools/build-assets.mjs", "watch_dir": "public" },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Matchmaker"] }
  ],
  "observability": { "enabled": true }
}
